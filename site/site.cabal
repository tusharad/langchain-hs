cabal-version:      3.0
name:               site
version:            0.1.0.0
synopsis:           Documentation site generator for langchain-hs
homepage:           https://tusharad.github.io/langchain-hs
license:            MIT
author:             Tushar Adhatrao
maintainer:         tusharadhatrao@gmail.com
category:           Web
build-type:         Simple

executable site
    main-is:          site.hs
    build-depends:
        base >= 4.14 && < 5,
        hakyll >= 4.15 && < 5,
        filepath,
        pandoc,
        pandoc-types,
        text,
        containers
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N -Wall
    default-language: Haskell2010
